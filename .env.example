# ==============================================================================
# ARCVA 2.0 - Configuracao de Ambiente
# ==============================================================================
#
# SETUP RAPIDO:
#
#   1. Copiar:  cp .env.example .env.local
#   2. Preencher VITE_CONVEX_URL (obtido automaticamente por `npx convex dev`)
#   3. Configurar Gemini API Key NO CONVEX (nao aqui!):
#      -> Convex Dashboard > Settings > Environment Variables
#      -> Adicionar: GEMINI_API_KEY = a_tua_chave_do_google
#      -> Obter chave em: https://aistudio.google.com/apikey
#   4. Correr: npx convex dev  (terminal 1)
#              npm run dev      (terminal 2)
#
# NOTA: A API key do Gemini e gerida server-side no Convex.
#       Nunca colocar chaves de API em variaveis VITE_*.
# ==============================================================================

# ------------------------------------------------------------------------------
# Convex Backend (Required)
# ------------------------------------------------------------------------------

# Convex deployment URL - preenchido automaticamente por `npx convex dev`
VITE_CONVEX_URL=

# ------------------------------------------------------------------------------
# Site Configuration
# ------------------------------------------------------------------------------

# Organization name displayed across the application
VITE_SITE_NAME=ARCVA

# Primary contact email for the organization
VITE_CONTACT_EMAIL=geral@arcva.pt

# Enable maintenance mode (true/false) - shows maintenance page when enabled
VITE_MAINTENANCE_MODE=false

# Organization logo URL (fallback to text logo if unavailable)
VITE_LOGO_URL=

# ------------------------------------------------------------------------------
# Contact Information
# ------------------------------------------------------------------------------

# Physical address displayed in footer and contact sections
VITE_ADDRESS=Largo do Pavilhao, N 1, 2395-301 Minde, Vale Alto

# Contact phone number (include country code)
VITE_PHONE=+351 212 345 678

# Google Maps link for directions
VITE_MAPS_URL=https://maps.app.goo.gl/zzqN8LJMgkFKd2mn9

# ------------------------------------------------------------------------------
# AI Chatbot Configuration
# ------------------------------------------------------------------------------

# Enable/disable the AI chatbot feature (true/false)
VITE_ENABLE_CHATBOT=true

# Show floating chatbot bubble on pages (true/false)
VITE_SHOW_CHATBOT_BUBBLE=true

# Primary Gemini model for complex queries
VITE_CHAT_MODEL=gemini-2.0-flash

# Fallback model for simple queries
VITE_CHAT_MODEL_FALLBACK=gemini-2.0-flash-lite

# Token budget for AI reasoning (higher = more complex responses, more cost)
VITE_THINKING_BUDGET=512

# Gemini TTS model for voice responses
VITE_TTS_MODEL=gemini-2.5-flash-preview-tts

# Extra system prompt instructions appended to the chatbot base prompt
VITE_AI_SYSTEM_PROMPT_EXTRA=

# Comma-separated topics the chatbot should focus on
VITE_AI_ALLOWED_TOPICS=ARCVA, Vale Alto, eventos, cultura, desporto, comunidade

# Comma-separated topics the chatbot politely refuses
VITE_AI_FORBIDDEN_TOPICS=politica partidaria, religiao, aconselhamento medico, conteudo adulto

# Enable query classification guardrails (true/false)
VITE_AI_GUARDRAILS_ENABLED=true

# ------------------------------------------------------------------------------
# AI Content Generation
# ------------------------------------------------------------------------------

# Default style prompt appended to image generation requests
VITE_DEFAULT_IMAGE_STYLE=Cinematic lighting, photorealistic, 4k, community atmosphere, warm tones

# Gemini model for image generation
VITE_IMAGE_MODEL=gemini-2.0-flash-exp

# Tone of voice for AI text enhancement (e.g., Professional, Casual, Formal)
VITE_CONTENT_TONE=Profissional e Inspirador

# Default image resolution for AI generation (1k/2k/4k)
VITE_IMAGE_RESOLUTION=1k

# ------------------------------------------------------------------------------
# Location & Social (fallbacks; DB settings via Admin take precedence)
# ------------------------------------------------------------------------------

# ARCVA coordinates used by location-aware AI queries
VITE_LATITUDE=39.515469
VITE_LONGITUDE=-8.586681

# Facebook page handle/id used for the footer social link
VITE_FACEBOOK_PAGE_ID=arcvalealto

# ------------------------------------------------------------------------------
# Server-side (Convex Dashboard > Settings > Environment Variables — NUNCA aqui)
# ------------------------------------------------------------------------------
#
# Obrigatoria (provider Gemini, o padrao):
#   GEMINI_API_KEY              -> https://aistudio.google.com/apikey
#
# Opcionais (defaults de modelos Gemini):
#   GEMINI_CHAT_MODEL           (default: gemini-2.0-flash)
#   GEMINI_CHAT_MODEL_FALLBACK  (default: gemini-2.0-flash-lite)
#   GEMINI_TTS_MODEL            (default: gemini-2.5-flash-preview-tts)
#   GEMINI_IMAGE_MODEL          (default: gemini-2.0-flash-exp)
#   SITE_LATITUDE / SITE_LONGITUDE
#
# Fornecedor de IA alternativo (tambem configuravel em Admin > IA & Chatbot):
#   AI_PROVIDER                 gemini | openrouter | custom
#   OPENROUTER_API_KEY          chave sk-or-... (https://openrouter.ai/keys)
#   OPENROUTER_MODEL            ex: openai/gpt-4o-mini
#   CUSTOM_AI_URL               endpoint compativel OpenAI (ex: http://localhost:11434/v1)
#   CUSTOM_AI_API_KEY           opcional
#   CUSTOM_AI_MODEL             ex: llama3.1
#
# NOTA: TTS, geracao de imagens e pesquisa/mapas usam sempre Gemini;
#       chat, classificacao e melhoria de texto seguem o fornecedor escolhido.

# ------------------------------------------------------------------------------
# Development Server Configuration
# ------------------------------------------------------------------------------

# Development server port
VITE_DEV_PORT=3000

# Development server host (0.0.0.0 for network access, localhost for local only)
VITE_DEV_HOST=localhost
